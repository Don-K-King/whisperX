# ===================================================================
# EvidoX Retention Scheduler Runner - vollständige Beispielkonfiguration
# ===================================================================
# Dieser Satz enthält alle für den dedizierten Runner relevanten Parameter.
# Pflichtfelder müssen in produktiven Deployments explizit gesetzt werden.

# ---------------------------
# Core Runtime (Pflicht)
# ---------------------------
RETENTION_DB_PATH=./data/jobs.db
RETENTION_SCHEDULER_LOCK_OWNER=retention-runner-01

# Scheduler-Steuerung (optional mit Defaults)
RETENTION_SCHEDULER_INTERVAL_SECONDS=300
RETENTION_SCHEDULER_BATCH_SIZE=100
RETENTION_SCHEDULER_LEASE_TTL_SECONDS=300
RETENTION_SCHEDULER_HEARTBEAT_SECONDS=60

# ---------------------------
# Bootstrap / Job-Wiring (Pflicht)
# ---------------------------
RETENTION_TENANT_IDS=tenant-a,tenant-b
RETENTION_AUDIT_LOG_PATH=./data/audit/retention-audit.jsonl

# Objekt-Storage Backend: filesystem | s3
RETENTION_OBJECT_STORAGE_BACKEND=filesystem

# Filesystem-Backend (Pflicht wenn backend=filesystem)
RETENTION_OBJECT_STORAGE_ROOT=./data/objects

# S3/MinIO-Backend (Pflicht wenn backend=s3)
RETENTION_OBJECT_STORAGE_S3_BUCKET=evodox-jobs
RETENTION_OBJECT_STORAGE_S3_ENDPOINT=http://minio:9000
RETENTION_OBJECT_STORAGE_S3_REGION=us-east-1
RETENTION_OBJECT_STORAGE_S3_ACCESS_KEY=minio
RETENTION_OBJECT_STORAGE_S3_SECRET_KEY=minio123
RETENTION_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true

# ---------------------------
# Retention Policy (optional)
# ---------------------------
RETENTION_POLICY_MIN_MONTHS=1
RETENTION_POLICY_MAX_MONTHS=120
RETENTION_POLICY_FALLBACK_MONTHS=12

# Governance-Version für Recovery-Klassen (aktuell nur v1)
RETENTION_RECOVERY_MAPPING_VERSION=v1

# ---------------------------
# Betriebs-/Deployment-Hardening
# ---------------------------
# Nur Preflight (Konfiguration validieren, nicht starten)
RETENTION_VALIDATE_ENV_ONLY=false

# Für Smoke-Starts/Tests: Prozess nach N Ticks beenden
# (leer lassen für Endlosschleife im normalen Betrieb)
RETENTION_SCHEDULER_MAX_TICKS=

# Logging
RETENTION_RUNNER_LOG_LEVEL=INFO
