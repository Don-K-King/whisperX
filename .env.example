# ===================================================================
# EvidoX Zielbetrieb - lokale Compose-Beispielwerte (nicht produktiv)
# ===================================================================
# Pflichtwerte sind je Service explizit markiert.

# API (Pflicht)
API_DB_DSN=postgresql://evodox:change-me@db:5432/evodox
API_BROKER_URL=amqp://evodox:change-me@broker:5672/
API_AUTH_ISSUER=http://auth:18080/realms/evodox
API_AUTH_AUDIENCE=evodox-api
API_AUTH_MODE=dev
API_DB_PATH=/runtime/jobs.db
API_AUDIT_LOG_PATH=/runtime/audit/api-audit.jsonl
API_UPLOAD_BASE_URL=http://object-storage:9000
API_UPLOAD_BUCKET=uploads
API_UPLOAD_SIGNING_SECRET=dev-only-secret
API_OBJECT_STORAGE_MODE=stub
API_DEV_DEFAULT_TENANT=tenant-a
API_DEV_DEFAULT_SUB=dev-user

# Worker (Pflicht)
WORKER_DB_DSN=postgresql://evodox:change-me@db:5432/evodox
WORKER_BROKER_URL=amqp://evodox:change-me@broker:5672/
WORKER_CONCURRENCY=2
WORKER_DB_PATH=/runtime/jobs.db
WORKER_MODE=stub
WORKER_BATCH_SIZE=25
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_AUDIT_LOG_PATH=/runtime/audit/worker-audit.jsonl

# Retention Runner (Pflicht)
RETENTION_DB_PATH=/runtime/jobs.db
RETENTION_SCHEDULER_LOCK_OWNER=retention-runner-01
RETENTION_TENANT_IDS=tenant-a,tenant-b
RETENTION_AUDIT_LOG_PATH=/runtime/audit/retention-audit.jsonl
RETENTION_OBJECT_STORAGE_BACKEND=s3
RETENTION_OBJECT_STORAGE_S3_BUCKET=evodox-jobs
RETENTION_OBJECT_STORAGE_S3_ENDPOINT=http://object-storage:9000
RETENTION_OBJECT_STORAGE_S3_REGION=us-east-1
RETENTION_OBJECT_STORAGE_S3_ACCESS_KEY=minio
RETENTION_OBJECT_STORAGE_S3_SECRET_KEY=change-me
RETENTION_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=true
RETENTION_RECOVERY_MAPPING_VERSION=v1
RETENTION_VALIDATE_ENV_ONLY=false

# Auth/Keycloak (Pflicht)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

# Datenbank/Broker/Object-Storage (Pflicht)
POSTGRES_DB=evodox
POSTGRES_USER=evodox
POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_USER=evodox
RABBITMQ_DEFAULT_PASS=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

# Optional
RETENTION_SCHEDULER_INTERVAL_SECONDS=300
RETENTION_SCHEDULER_BATCH_SIZE=100
RETENTION_SCHEDULER_LEASE_TTL_SECONDS=300
RETENTION_SCHEDULER_HEARTBEAT_SECONDS=60
RETENTION_POLICY_MIN_MONTHS=1
RETENTION_POLICY_MAX_MONTHS=120
RETENTION_POLICY_FALLBACK_MONTHS=12
RETENTION_SCHEDULER_MAX_TICKS=
RETENTION_RUNNER_LOG_LEVEL=INFO
WORKER_LOG_LEVEL=INFO
WORKER_MAX_TICKS=
EVODOX_IMAGE=evodox-local:dev
