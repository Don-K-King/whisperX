# ===================================================================
# EvidoX Zielbetrieb - Produktionsprofil (Template)
# ===================================================================
# Keine echten Secrets einchecken. Werte via Secret-Manager injecten.

# API (Pflicht)
API_DB_DSN=postgresql://<db-user>:<db-password>@db:5432/<db-name>
API_BROKER_URL=amqp://<broker-user>:<broker-password>@broker:5672/
API_AUTH_ISSUER=https://auth.example.com/realms/evodox
API_AUTH_AUDIENCE=evodox-api
API_AUTH_MODE=oidc
API_DB_PATH=/var/lib/evodox/jobs.db
API_AUDIT_LOG_PATH=/var/log/evodox/api-audit.jsonl
API_UPLOAD_BASE_URL=https://storage.example.com
API_UPLOAD_BUCKET=<bucket-name>
API_UPLOAD_SIGNING_SECRET=<secret-ref>
API_OBJECT_STORAGE_MODE=strict
API_DEV_DEFAULT_TENANT=<not-used-in-prod>
API_DEV_DEFAULT_SUB=<not-used-in-prod>

# Worker (Pflicht)
WORKER_DB_DSN=postgresql://<db-user>:<db-password>@db:5432/<db-name>
WORKER_BROKER_URL=amqp://<broker-user>:<broker-password>@broker:5672/
WORKER_CONCURRENCY=4
WORKER_DB_PATH=/var/lib/evodox/jobs.db
WORKER_MODE=whisperx
WORKER_BATCH_SIZE=25
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_AUDIT_LOG_PATH=/var/log/evodox/worker-audit.jsonl
WORKER_OBJECT_STORAGE_BASE_URL=https://storage.example.com
WORKER_OBJECT_STORAGE_BUCKET=<bucket-name>
WORKER_WHISPERX_MODEL=small
WORKER_WHISPERX_DEVICE=cuda
WORKER_WHISPERX_COMPUTE_TYPE=float16
WORKER_WHISPERX_DEVICE_INDEX=0
WORKER_WHISPERX_BATCH_SIZE=4
WORKER_ALLOWED_QUEUES=
WORKER_WHISPERX_MODEL_DIR=/var/lib/evodox/models
WORKER_WHISPERX_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
WORKER_ENABLE_DIARIZATION=true
WORKER_WHISPERX_VAD_METHOD=silero
WORKER_MEDIA_TEMP_DIR=/tmp/evodox-worker
WORKER_WHISPERX_TIMEOUT_SECONDS=0
HF_TOKEN=<secret-ref>

# Retention Runner (Pflicht)
RETENTION_DB_PATH=/var/lib/evodox/jobs.db
RETENTION_SCHEDULER_LOCK_OWNER=<cluster-node-unique-id>
RETENTION_TENANT_IDS=<tenant-a>,<tenant-b>
RETENTION_AUDIT_LOG_PATH=/var/log/evodox/retention-audit.jsonl
RETENTION_OBJECT_STORAGE_BACKEND=s3
RETENTION_OBJECT_STORAGE_S3_BUCKET=<bucket-name>
RETENTION_OBJECT_STORAGE_S3_ENDPOINT=https://s3.example.com
RETENTION_OBJECT_STORAGE_S3_REGION=eu-central-1
RETENTION_OBJECT_STORAGE_S3_ACCESS_KEY=<secret-ref>
RETENTION_OBJECT_STORAGE_S3_SECRET_KEY=<secret-ref>
RETENTION_OBJECT_STORAGE_S3_FORCE_PATH_STYLE=false
RETENTION_RECOVERY_MAPPING_VERSION=v1
RETENTION_VALIDATE_ENV_ONLY=false

# Auth/Keycloak (Pflicht)
KEYCLOAK_ADMIN=<secret-ref>
KEYCLOAK_ADMIN_PASSWORD=<secret-ref>

# Datenbank/Broker/Object-Storage (Pflicht)
POSTGRES_DB=<db-name>
POSTGRES_USER=<db-user>
POSTGRES_PASSWORD=<secret-ref>
RABBITMQ_DEFAULT_USER=<broker-user>
RABBITMQ_DEFAULT_PASS=<secret-ref>
MINIO_ROOT_USER=<secret-ref>
MINIO_ROOT_PASSWORD=<secret-ref>

# Optional
RETENTION_SCHEDULER_INTERVAL_SECONDS=300
RETENTION_SCHEDULER_BATCH_SIZE=100
RETENTION_SCHEDULER_LEASE_TTL_SECONDS=300
RETENTION_SCHEDULER_HEARTBEAT_SECONDS=60
RETENTION_POLICY_MIN_MONTHS=1
RETENTION_POLICY_MAX_MONTHS=120
RETENTION_POLICY_FALLBACK_MONTHS=12
RETENTION_SCHEDULER_MAX_TICKS=
RETENTION_RUNNER_LOG_LEVEL=INFO
WORKER_LOG_LEVEL=INFO
WORKER_MAX_TICKS=
EVODOX_IMAGE=ghcr.io/evodox/evodox:<release-tag>
